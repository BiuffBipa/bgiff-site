# ---- BGIFF platform · environment variables (never commit real values) ----
# Copy to .env.local for development. Production/staging values live in Vercel env + Supabase Vault.

APP_ENV=development                 # development | staging | production  (gates the outbox send policy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (dedicated BGIFF project — NEVER biuff-founding-2026)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
DATABASE_URL=                       # for migrations / CI (postgres://…)

# Security
HASH_PEPPER=                        # 32+ random bytes, base64; used for buyer_email_hash / ip_hash
CRON_SECRET=                        # Vercel Cron → /api/platform/cron/* Authorization: Bearer <CRON_SECRET>

# Intake
FILMFREEWAY_API_KEY=                # read-only
FILMFREEWAY_WEBHOOK_SECRET=
FESTHOME_WEBHOOK_SECRET=

# Email (Resend) — transactional and marketing use separate domains
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Payments (Stripe) — test keys until founder "go"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Media (Bunny.net)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_TOKEN_AUTH_KEY=               # signed playback URLs

# AI
ANTHROPIC_API_KEY=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional
PLATFORM_ADMIN_ENABLED=false        # extra env guard for admin routes on top of the DB flag
